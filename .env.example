# .env.example
# Factor III - Config: copy this file to .env for local development.
# Never commit the real .env to version control.

# Server (Factor VII - Port Binding)
PORT=3000

# App metadata
NODE_ENV=development
APP_NAME=twelve-factor-api

# Backing services (Factor IV) - uncomment when adding a real database/cache
# DATABASE_URL=postgres://user:password@localhost:5432/mydb
# REDIS_URL=redis://localhost:6379
